{
  "app-id": "io.github.houssemko.Grab",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "command": "grab",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin"
  },
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=dri",
    "--talk-name=org.freedesktop.portal.*",
    "--talk-name=org.gtk.vfs.*",
    "--filesystem=xdg-download",
    "--filesystem=xdg-config/dconf:ro",
    "--filesystem=~/.config/BraveSoftware/Brave-Browser:ro",
    "--filesystem=~/.config/BraveSoftware/Brave-Browser-Beta:ro",
    "--filesystem=~/.config/BraveSoftware/Brave-Browser-Nightly:ro",
    "--filesystem=~/.config/BraveSoftware/Brave-Origin-Beta:ro",
    "--filesystem=~/.config/BraveSoftware/Brave-Origin-Nightly:ro",
    "--filesystem=~/.config/BraveSoftware/Brave-Browser-Origin-Nightly:ro",
    "--filesystem=~/.config/google-chrome:ro",
    "--filesystem=~/.config/google-chrome-beta:ro",
    "--filesystem=~/.config/google-chrome-unstable:ro",
    "--filesystem=~/.config/chromium:ro",
    "--filesystem=~/.config/chromium-beta:ro",
    "--filesystem=~/.config/microsoft-edge:ro",
    "--filesystem=~/.config/microsoft-edge-beta:ro",
    "--filesystem=~/.config/microsoft-edge-dev:ro",
    "--filesystem=~/.config/microsoft-edge-canary:ro",
    "--filesystem=~/.mozilla/firefox:ro",
    "--filesystem=~/.config/mozilla/firefox:ro",
    "--filesystem=~/snap/firefox/common/.mozilla/firefox:ro",
    "--filesystem=~/.config/opera:ro",
    "--filesystem=~/.config/opera-beta:ro",
    "--filesystem=~/.config/opera-developer:ro",
    "--filesystem=~/.config/vivaldi:ro",
    "--filesystem=~/.config/vivaldi-snapshot:ro",
    "--filesystem=~/.config/naver-whale:ro",
    "--filesystem=~/.zen:ro",
    "--filesystem=~/.config/zen:ro"
  ],
  "modules": [
    {
      "name": "grab",
      "buildsystem": "meson",
      "builddir": true,
      "config-opts": [
        "-Dbuildtype=release"
      ],
      "build-options": {
        "env": {
          "CARGO_NET_OFFLINE": "true"
        }
      },
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/houssemko/Grab.git",
          "tag": "v4.4.3"
        },
        "cargo-sources.json",
        {
          "type": "shell",
          "commands": [
            "mkdir -p .cargo",
            "cp -vf cargo/config .cargo/config.toml"
          ]
        }
      ]
    }
  ]
}
