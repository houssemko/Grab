{
  "app-id": "io.github.houssemko.Grab",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "command": "grab",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin"
  },
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=dri",
    "--talk-name=org.freedesktop.portal.*",
    "--talk-name=org.gtk.vfs.*",
    "--talk-name=org.freedesktop.secrets",
    "--filesystem=xdg-download",
    "--filesystem=xdg-config/dconf:ro",
    "--filesystem=~/.config/BraveSoftware/Brave-Browser:ro",
    "--filesystem=~/.config/BraveSoftware/Brave-Browser-Beta:ro",
    "--filesystem=~/.config/BraveSoftware/Brave-Browser-Nightly:ro",
    "--filesystem=~/.config/BraveSoftware/Brave-Origin-Beta:ro",
    "--filesystem=~/.config/BraveSoftware/Brave-Origin-Nightly:ro",
    "--filesystem=~/.config/BraveSoftware/Brave-Browser-Origin-Nightly:ro",
    "--filesystem=~/.config/google-chrome:ro",
    "--filesystem=~/.config/chromium:ro",
    "--filesystem=~/.config/microsoft-edge:ro",
    "--filesystem=~/.mozilla/firefox:ro",
    "--filesystem=~/.config/mozilla/firefox:ro",
    "--filesystem=~/snap/firefox/common/.mozilla/firefox:ro",
    "--filesystem=~/.config/opera:ro",
    "--filesystem=~/.config/vivaldi:ro",
    "--filesystem=~/.config/naver-whale:ro"
  ],
  "modules": [
    {
      "name": "deno",
      "buildsystem": "simple",
      "build-commands": [
        "install -Dm755 deno /app/bin/deno",
        "deno --version"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/denoland/deno/releases/download/v2.9.6/deno-x86_64-unknown-linux-gnu.zip",
          "sha256": "394f07f4da2bebe6ce6f1e7ce0fa16429b29b08c35e3fac3fe25972676dff4b2"
        }
      ]
    },
    {
      "name": "grab",
      "buildsystem": "meson",
      "builddir": true,
      "config-opts": [
        "-Dbuildtype=release"
      ],
      "build-options": {
        "env": {
          "CARGO_NET_OFFLINE": "true"
        }
      },
      "sources": [
        {
          "type": "dir",
          "path": ".."
        },
        "cargo-sources.json",
        {
          "type": "shell",
          "commands": [
            "mkdir -p .cargo",
            "cp -vf cargo/config .cargo/config.toml"
          ]
        }
      ]
    }
  ]
}
