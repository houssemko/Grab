[Desktop Entry]
Name=Grab
Comment=Download files with GNU wget
Exec=grab %U
Icon=org.gnome.Grab
Terminal=false
Type=Application
Categories=Network;FileTransfer;GTK;
Keywords=download;wget;manager;
StartupNotify=true
DBusActivatable=true
MimeType=text/uri-list;x-scheme-handler/http;x-scheme-handler/https;
SingleMainWindow=true
