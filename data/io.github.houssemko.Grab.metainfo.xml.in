<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.houssemko.Grab</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>Grab</name>
  <summary>A GNOME download manager with pause, resume and history</summary>
  <description>
    <p>
      Queue, pause, resume and monitor file downloads with smart
      auto-resume, in a native GNOME interface.
    </p>
  </description>
  <launchable type="desktop-id">io.github.houssemko.Grab.desktop</launchable>
  <developer>
    <name>Grab Contributors</name>
  </developer>
  <url type="homepage">https://github.com/houssemko/grab</url>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="0.2.1-alpha.10" date="2026-09-08">
      <description>
        <p>Segmented downloads resume across restarts instead of starting over.</p>
      </description>
    </release>
    <release version="0.2.1-alpha.9" date="2026-09-08">
      <description>
        <p>Survives killed segmented downloads without corrupting files; leaner engine and test helpers.</p>
      </description>
    </release>
    <release version="0.2.1-alpha.8" date="2026-09-08">
      <description>
        <p>Survives throttling hosts by dropping to one stream; fixes segmented resume corrupting finished files.</p>
      </description>
    </release>
    <release version="0.2.1-alpha.7" date="2026-09-07">
      <description>
        <p>Downloads take the server-advertised filename, so video links save with the right extension.</p>
      </description>
    </release>
    <release version="0.2.1-alpha.6" date="2026-09-07">
      <description>
        <p>Finished downloads show their final size where the speed was.</p>
      </description>
    </release>
    <release version="0.2.1-alpha.5" date="2026-09-07">
      <description>
        <p>URL length limit, CI checks on every push, and contributor documentation.</p>
      </description>
    </release>
    <release version="0.2.1-alpha.4" date="2026-09-07">
      <description>
        <p>New Download keeps its pill shape but sizes to its text instead of stretching full-width.</p>
      </description>
    </release>
    <release version="0.2.1-alpha.3" date="2026-09-07">
      <description>
        <p>Smaller New Download button; header add button only shows alongside the download list.</p>
      </description>
    </release>
    <release version="0.2.1-alpha.2" date="2026-09-07">
      <description>
        <p>HIG compliance pass: failure banner, undo for removals, keyboard shortcuts, screen-reader labels, and release hardening.</p>
      </description>
    </release>
    <release version="0.2.1" date="2026-09-07">
      <description>
        <p>Native HTTP backend with pause/resume, background downloads, and download history.</p>
      </description>
    </release>
    <release version="0.1.0" date="2026-09-05">
      <description>
        <p>Initial release.</p>
      </description>
    </release>
  </releases>
</component>
