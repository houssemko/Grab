#: data/io.github.houssemko.Grab.gschema.xml
msgid "Proxy mode"
msgstr ""

#: data/io.github.houssemko.Grab.gschema.xml
msgid "System honors the desktop proxy settings; manual uses the proxy below; direct disables proxying. Applies to newly started downloads; torrents always go direct."
msgstr ""

#: data/io.github.houssemko.Grab.gschema.xml
msgid "Proxy type"
msgstr ""

#: data/io.github.houssemko.Grab.gschema.xml
msgid "One of http, https or socks5. SOCKS5 resolves names remotely."
msgstr ""

#: data/io.github.houssemko.Grab.gschema.xml
msgid "Proxy host"
msgstr ""

#: data/io.github.houssemko.Grab.gschema.xml
msgid "Proxy hostname or address, e.g. 127.0.0.1 for a local Tor forwarder."
msgstr ""

#: data/io.github.houssemko.Grab.gschema.xml
msgid "Proxy port"
msgstr ""

#: data/io.github.houssemko.Grab.gschema.xml
msgid "Proxy port, e.g. 9050 for Tor."
msgstr ""

#: data/io.github.houssemko.Grab.gschema.xml
msgid "Subtitle language"
msgstr ""

#: data/io.github.houssemko.Grab.gschema.xml
msgid "Download subtitles in this language beside new video downloads, with automatic-caption fallback when the language is missing. 'off' disables subtitle downloads."
msgstr ""

#: data/io.github.houssemko.Grab.gschema.xml
msgid "Torrent peer blocklist"
msgstr ""

#: data/io.github.houssemko.Grab.gschema.xml
msgid ""
"URL of a peer blocklist (eMule ipfilter.dat format) applied to every "
"torrent. Empty means disabled. Applies when the torrent engine first starts."
msgstr ""

#: data/io.github.houssemko.Grab.gschema.xml
msgid "Find torrent peers on the local network"
msgstr ""

#: data/io.github.houssemko.Grab.gschema.xml
msgid ""
"Discover torrent peers on the local network via Local Service Discovery. "
"Applies when the torrent engine first starts."
msgstr ""

